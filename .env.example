# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# YOUTUBE_API_KEY: Optional. YouTube Data API v3 key used by functions/api/telemetry.ts
# for exact subscriber/view counts. Without it, the function falls back to parsing the
# public channel page. Set it in Cloudflare Pages > Settings > Environment variables.
YOUTUBE_API_KEY="MY_YOUTUBE_API_KEY"

# SPOTLIGHT_VIDEO_ID: Optional. Pins this YouTube video id as the site's Spotlight
# (must be one of the channel's recent uploads). Leave unset for automatic picks.
SPOTLIGHT_VIDEO_ID=""

# VIDEO_STATS: Optional Cloudflare KV binding (not an env var) used by
# functions/api/videos.ts to store hourly view snapshots for "Trending now".
# See wrangler.toml for setup. Without it, Spotlight uses "rising" (views/day).
